{
  "expo": {
    "name": "Marine Tech",
    "slug": "marine-tech",
    "owner": "cgrayy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marine-tech",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060a12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grayyachts.marinetech",
      "buildNumber": "17",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Marine Tech needs camera access to photograph boat conditions, HIN plates, and engine hours during service inspections.",
        "NSPhotoLibraryUsageDescription": "Marine Tech needs photo library access to attach existing photos to service reports.",
        "NSPhotoLibraryAddUsageDescription": "Marine Tech needs permission to save inspection photos to your photo library."
      }
    },
    "android": {
      "package": "com.grayyachts.marinetech",
      "versionCode": 15,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#060a12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "5e70f74a-b7b2-49e0-a65f-4e40d2527fb0"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
